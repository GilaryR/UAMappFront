<UserControl x:Class="SistemaHorario.UI.Controls.FilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="90">

    <Border Background="White"
            BorderBrush="#D9E2EC"
            BorderThickness="1"
            CornerRadius="14"
            Padding="18">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <TextBlock x:Name="TxtTitulo"
                       Text="Filtros"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#1F2937"
                       Margin="0,0,0,14"/>

            <!-- Contenedor flexible de filtros -->
            <WrapPanel Grid.Row="1"
                       x:Name="PnlFiltros"
                       Orientation="Horizontal"
                       VerticalAlignment="Center">

                <!-- Buscador -->
                <StackPanel x:Name="PnlBusqueda"
                            Width="280"
                            Margin="0,0,14,12">

                    <TextBlock Text="Búsqueda"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="TxtBusqueda"
                             Height="38"
                             Padding="12,0"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             BorderBrush="#D1D5DB"
                             BorderThickness="1"/>
                </StackPanel>

                <!-- Filtro 1 -->
                <StackPanel x:Name="PnlFiltro1"
                            Width="180"
                            Margin="0,0,14,12">

                    <TextBlock x:Name="LblFiltro1"
                               Text="Filtro 1"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="CmbFiltro1"
                              Height="38"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"/>
                </StackPanel>

                <!-- Filtro 2 -->
                <StackPanel x:Name="PnlFiltro2"
                            Width="180"
                            Margin="0,0,14,12">

                    <TextBlock x:Name="LblFiltro2"
                               Text="Filtro 2"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="CmbFiltro2"
                              Height="38"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"/>
                </StackPanel>

                <!-- Fecha desde -->
                <StackPanel x:Name="PnlFechaDesde"
                            Width="170"
                            Margin="0,0,14,12">

                    <TextBlock Text="Fecha desde"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <DatePicker x:Name="DtpFechaDesde"
                                Height="38"/>
                </StackPanel>

                <!-- Fecha hasta -->
                <StackPanel x:Name="PnlFechaHasta"
                            Width="170"
                            Margin="0,0,14,12">

                    <TextBlock Text="Fecha hasta"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <DatePicker x:Name="DtpFechaHasta"
                                Height="38"/>
                </StackPanel>

                <!-- Botones -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,12">

                    <Button x:Name="BtnAplicar"
                            Content="Filtrar"
                            Width="95"
                            Height="38"
                            Background="#0878B8"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnAplicar_Click"/>

                    <Button x:Name="BtnLimpiar"
                            Content="Limpiar"
                            Width="95"
                            Height="38"
                            Margin="10,0,0,0"
                            Background="#E5E7EB"
                            Foreground="#111827"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnLimpiar_Click"/>
                </StackPanel>
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>