<UserControl x:Class="SistemaHorario.UI.Controls.MultiSelectDropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="360"
             MinHeight="120">

    <Border Background="White"
            BorderBrush="#D9E2EC"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <TextBlock x:Name="TxtTitulo"
                       Text="Seleccionar"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="#1F2937"
                       Margin="0,0,0,8"/>

            <!-- Barra superior -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>

                <Border Background="#F9FAFB"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,0">

                    <TextBlock x:Name="TxtResumen"
                               Text="Sin elementos seleccionados"
                               Foreground="#6B7280"
                               FontSize="13"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <Button x:Name="BtnDesplegar"
                        Grid.Column="1"
                        Content="+"
                        FontSize="22"
                        FontWeight="Bold"
                        Background="#006AA6"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="8,0,0,0"
                        Click="BtnDesplegar_Click" Height="42" VerticalAlignment="Bottom"/>
            </Grid>

            <!-- Lista desplegable -->
            <Border x:Name="PnlOpciones"
                    Grid.Row="2"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,10,0,0"
                    Padding="8"
                    Visibility="Collapsed">

                <ScrollViewer MaxHeight="170"
                              VerticalScrollBarVisibility="Auto">

                    <ItemsControl x:Name="LstOpciones">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,3"
                                        Padding="10,7"
                                        Background="#F3F4F6"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Click="BtnOpcion_Click">

                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="+"
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   Foreground="#0878B8"
                                                   Margin="0,0,10,0"
                                                   DockPanel.Dock="Left"/>

                                        <TextBlock Text="{Binding Texto}"
                                                   FontSize="13"
                                                   Foreground="#1F2937"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Panel seleccionados -->
            <Border Grid.Row="3"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,10,0,0"
                    Padding="8"
                    MinHeight="54">

                <WrapPanel x:Name="PnlSeleccionados"/>
            </Border>
        </Grid>
    </Border>
</UserControl>