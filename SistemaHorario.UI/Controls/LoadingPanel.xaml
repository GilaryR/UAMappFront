<UserControl x:Class="SistemaHorario.UI.Controls.LoadingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">

    <Grid Background="#80000000">

        <Border Width="330"
                Height="190"
                Background="White"
                CornerRadius="18"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel VerticalAlignment="Center">

                <ProgressBar x:Name="BarraProgreso"
                             Height="8"
                             IsIndeterminate="True"
                             Margin="0,0,0,25"/>

                <TextBlock x:Name="TxtMensaje"
                           Text="Cargando..."
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#1F2937"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <TextBlock Text="Por favor espera un momento"
                           FontSize="13"
                           Foreground="#6B7280"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>