<Window x:Class="SistemaHorario.UI.Dialogs.Docentes.DisponibilidadDocenteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disponibilidad docente"
        Width="920"
        Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Border Background="White"
            CornerRadius="18"
            Padding="28">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,22">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="TxtTitulo"
                               Text="Disponibilidad docente"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <TextBlock x:Name="TxtSubtitulo"
                               Text="Seleccione las franjas horarias disponibles"
                               Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="#6B7280"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Width="36"
                        Height="36"
                        Content="✕"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnCerrar_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid x:Name="GridDisponibilidad"/>
            </ScrollViewer>

            <Grid Grid.Row="2"
                  Margin="0,24,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnCancelar"
                        Grid.Column="1"
                        Width="130"
                        Height="40"
                        Content="Cancelar"
                        Background="#E5E7EB"
                        Foreground="#111827"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BtnCancelar_Click"/>

                <Button x:Name="BtnGuardar"
                        Grid.Column="3"
                        Width="150"
                        Height="40"
                        Content="Guardar"
                        Background="#006AA6"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BtnGuardar_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>