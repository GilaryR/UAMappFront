<Window x:Class="SistemaHorario.UI.Dialogs.Docentes.AgregarEditarDocenteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Docente"
        Width="980"
        Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

	<Border Background="White"
            CornerRadius="18"
            Padding="30">

		<Grid>

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<Grid Margin="0,0,0,28">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel>
					<TextBlock x:Name="TxtTitulo"
                               Text="Agregar docente"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#111827"/>

					<TextBlock x:Name="TxtSubtitulo"
                               Text="Complete la información del docente"
                               Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="#6B7280"/>
				</StackPanel>

				<Button Grid.Column="1"
                        Width="36"
                        Height="36"
                        Content="✕"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnCerrar_Click"/>
			</Grid>

			<ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

				<StackPanel>

					<Border Background="#F9FAFB"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="24">

						<StackPanel>

							<TextBlock Text="Información del docente"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#111827"
                                       Margin="0,0,0,22"/>

							<Grid Margin="0,0,0,18">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="22"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<StackPanel>
									<TextBlock Text="Nombre completo"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>
									<TextBox x:Name="TxtNombreCompleto"
                                             Height="42"
                                             FontSize="14"/>
								</StackPanel>

								<StackPanel Grid.Column="2">
									<TextBlock Text="Identificación"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>
									<TextBox x:Name="TxtIdentificacion"
                                             Height="42"
                                             FontSize="14"/>
								</StackPanel>
							</Grid>

							<Grid Margin="0,0,0,18">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="22"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<StackPanel>
									<TextBlock Text="Correo institucional"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>
									<TextBox x:Name="TxtCorreo"
                                             Height="42"
                                             FontSize="14"/>
								</StackPanel>

								<StackPanel Grid.Column="2">
									<TextBlock Text="Estado"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>
									<ComboBox x:Name="CmbEstado"
                                              Height="42"
                                              FontSize="14">
										<ComboBoxItem Content="Activo"
                                                      IsSelected="True"/>
										<ComboBoxItem Content="Inactivo"/>
									</ComboBox>
								</StackPanel>
							</Grid>

							<StackPanel Margin="0,0,0,18">
								<TextBlock Text="Materias"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
								<TextBox x:Name="TxtMaterias"
                                         Height="80"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontSize="14"/>
							</StackPanel>

							<Border Background="#EFF6FF"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="18">

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>

									<StackPanel>
										<TextBlock Text="Disponibilidad docente"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#1E3A8A"/>

										<TextBlock Text="Configure las franjas disponibles del docente"
                                                   Margin="0,6,0,0"
                                                   FontSize="13"
                                                   Foreground="#4B5563"/>
									</StackPanel>

									<Button x:Name="BtnDisponibilidad"
                                            Grid.Column="1"
                                            Width="210"
                                            Height="40"
                                            Content="Disponibilidad docente"
                                            Background="#006AA6"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Click="BtnDisponibilidad_Click"/>
								</Grid>
							</Border>
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>

			<Grid Grid.Row="2"
                  Margin="0,24,0,0">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="14"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<Button x:Name="BtnCancelar"
                        Grid.Column="1"
                        Width="130"
                        Height="42"
                        Content="Cancelar"
                        Background="#E5E7EB"
                        Foreground="#111827"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BtnCancelar_Click"/>

				<Button x:Name="BtnGuardar"
                        Grid.Column="3"
                        Width="160"
                        Height="42"
                        Content="Crear docente"
                        Background="#006AA6"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BtnGuardar_Click"/>
			</Grid>
		</Grid>
	</Border>
</Window>