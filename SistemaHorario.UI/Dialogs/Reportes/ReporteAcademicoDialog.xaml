<Window x:Class="SistemaHorario.UI.Dialogs.Reportes.ReporteAcademicoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista previa del reporte"
        Width="900"
        Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="White">

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="TxtTitulo"
                       Text="Vista previa del reporte"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#111111"/>

            <TextBlock x:Name="TxtSubtitulo"
                       Text="Información consultada desde la API"
                       FontSize="14"
                       Foreground="#6B7280"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#F9FAFB"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <TextBox x:Name="TxtContenido"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas"
                     FontSize="13"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="#F9FAFB"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,22,0,0">
            <Button Content="Cerrar"
                    Width="160"
                    Height="38"
                    Background="White"
                    Foreground="#006AA6"
                    BorderBrush="#006AA6"
                    BorderThickness="1"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="BtnCerrar_Click"/>
        </StackPanel>
    </Grid>
</Window>
