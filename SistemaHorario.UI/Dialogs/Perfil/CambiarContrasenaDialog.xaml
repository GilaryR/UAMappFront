<Window x:Class="SistemaHorario.UI.Dialogs.Perfil.CambiarContrasenaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambiar contraseña"
        Width="520"
        Height="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="White"
            CornerRadius="10"
            Padding="26">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <TextBlock Text="Cambiar contraseña"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,0,0,22"/>

                <TextBlock Text="Contraseña actual *"
                           FontWeight="Bold"
                           FontSize="15"
                           Margin="0,0,0,8"/>

                <PasswordBox x:Name="TxtContrasenaActual"
                             Height="36"
                             Padding="10,5"
                             Margin="0,0,0,18"/>

                <TextBlock Text="Contraseña nueva *"
                           FontWeight="Bold"
                           FontSize="15"
                           Margin="0,0,0,8"/>

                <PasswordBox x:Name="TxtNuevaContrasena"
                             Height="36"
                             Padding="10,5"
                             Margin="0,0,0,18"/>

                <TextBlock Text="Confirmar contraseña *"
                           FontWeight="Bold"
                           FontSize="15"
                           Margin="0,0,0,8"/>

                <PasswordBox x:Name="TxtConfirmarContrasena"
                             Height="36"
                             Padding="10,5"/>
            </StackPanel>

            <Grid Grid.Row="1"
                  VerticalAlignment="Bottom">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="Cancelar"
                        Height="40"
                        Background="White"
                        Foreground="#9A9A9A"
                        BorderBrush="#DADADA"
                        BorderThickness="1"
                        FontWeight="Bold"
                        Click="BtnCancelar_Click"/>

                <Button Grid.Column="3"
                        Content="Guardar"
                        Height="40"
                        Background="#006AA6"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="BtnGuardar_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>