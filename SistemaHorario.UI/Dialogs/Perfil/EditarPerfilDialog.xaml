<Window x:Class="SistemaHorario.UI.Dialogs.Perfil.EditarPerfilDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar perfil"
        Width="760"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="White"
            CornerRadius="10"
            Padding="24">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="78"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Nombre completo *"
                               FontWeight="Bold"
                               FontSize="15"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="TxtNombreCompleto"
                             Height="34"
                             FontSize="14"
                             Padding="10,5"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Correo institucional"
                               FontWeight="Bold"
                               FontSize="15"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="TxtCorreoInstitucional"
                             Height="34"
                             FontSize="14"
                             Padding="10,5"
                             IsEnabled="False"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="Teléfono *"
                               FontWeight="Bold"
                               FontSize="15"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="TxtTelefono"
                             Height="34"
                             FontSize="14"
                             Padding="10,5"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="Rol"
                               FontWeight="Bold"
                               FontSize="15"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="TxtRol"
                             Height="34"
                             FontSize="14"
                             Padding="10,5"
                             IsEnabled="False"/>
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3">
                    <TextBlock Text="Facultad / Programa"
                               FontWeight="Bold"
                               FontSize="15"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="TxtFacultadPrograma"
                             Height="34"
                             FontSize="14"
                             Padding="10,5"
                             IsEnabled="False"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  VerticalAlignment="Bottom">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="Cancelar"
                        Height="42"
                        Background="White"
                        Foreground="#9A9A9A"
                        BorderBrush="#DADADA"
                        BorderThickness="1"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"
                        Click="BtnCancelar_Click"/>

                <Button Grid.Column="3"
                        Content="Guardar"
                        Height="42"
                        Background="#006AA6"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"
                        Click="BtnGuardar_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>