<Window x:Class="SistemaHorario.UI.Dialogs.Horarios.RechazarHorarioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rechazar horario"
        Height="300"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F7FA">

    <Border Background="White"
            CornerRadius="14"
            Padding="24"
            Margin="16">

        <StackPanel>
            <TextBlock Text="Rechazar horario"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#111827"/>

            <TextBlock Text="Indique el motivo por el cual se rechaza este horario."
                       Margin="0,8,0,14"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="#6B7280"/>

            <TextBox x:Name="TxtMotivo"
                     Height="90"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="13"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">

                <Button Content="Cancelar"
                        Width="110"
                        Height="36"
                        Margin="0,0,12,0"
                        Background="#E5E7EB"
                        Foreground="#111827"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="BtnCancelar_Click"/>

                <Button Content="Rechazar"
                        Width="110"
                        Height="36"
                        Background="#B00020"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="BtnRechazar_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
