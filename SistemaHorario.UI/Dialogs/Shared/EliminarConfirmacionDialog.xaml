<Window x:Class="SistemaHorario.UI.Dialogs.Shared.EliminarConfirmacionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eliminar"
        Width="520"
        Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Border Background="White"
            CornerRadius="10"
            Padding="22">

        <StackPanel VerticalAlignment="Center">

            <Image Source="/Assets/Icons/IcAdvertenciaR.png"
                   Width="58"
                   Height="58"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>

            <TextBlock Text="ELIMINAR"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="Black"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18"/>

            <TextBlock x:Name="TxtMensaje"
                       Text="¿Estás seguro que deseas eliminar?&#x0a;Debes escribir la palabra eliminar."
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#9B9B9B"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,22"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancelar"
                        Width="88"
                        Height="34"
                        HorizontalAlignment="Left"
                        Background="White"
                        Foreground="#A3A3A3"
                        BorderBrush="#BDBDBD"
                        BorderThickness="1"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BtnCancelar_Click"/>

                <Border Grid.Column="1"
                        Height="42"
                        Background="White"
                        BorderBrush="#D9D9D9"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="10,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="🗑"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <TextBox x:Name="TxtConfirmacion"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 VerticalContentAlignment="Center"
                                 TextChanged="TxtConfirmacion_TextChanged"/>

                        <TextBlock x:Name="TxtPlaceholder"
                                   Grid.Column="1"
                                   Text="Escribir"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#A3A3A3"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Button x:Name="BtnGuardar"
                        Grid.Column="2"
                        Content="Guardar"
                        Width="88"
                        Height="34"
                        HorizontalAlignment="Right"
                        Background="#006AA6"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"
                        IsEnabled="False"
                        Opacity="0.55"
                        Click="BtnGuardar_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>