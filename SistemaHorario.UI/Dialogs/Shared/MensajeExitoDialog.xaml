<Window x:Class="SistemaHorario.UI.Dialogs.Shared.MensajeExitoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operación exitosa"
        Width="430"
        Height="290"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Border Background="White"
            CornerRadius="10"
            BorderBrush="#333333"
            BorderThickness="1"
            Padding="28"
            Width="428">

        <StackPanel VerticalAlignment="Center">

            <Image Source="/Assets/Icons/IcCorrecto.png"
                   Width="76"
                   Height="76"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

            <TextBlock x:Name="TxtTitulo"
                       Text="Operación realizada correctamente"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="Black"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       LineHeight="30"
                       MaxWidth="360"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <Button Content="Salir"
                    Width="180"
                    Height="40"
                    Background="White"
                    Foreground="#9B9B9B"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    FontSize="15"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="BtnSalir_Click"/>
        </StackPanel>
    </Border>
</Window>