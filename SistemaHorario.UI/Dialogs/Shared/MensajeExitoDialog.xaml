<Window x:Class="SistemaHorario.UI.Dialogs.Shared.MensajeExitoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operación exitosa"
        Width="348"
        Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Border Background="White"
            CornerRadius="8"
            BorderBrush="#333333"
            BorderThickness="1"
            Padding="22" HorizontalAlignment="Left" Width="346">

        <StackPanel VerticalAlignment="Center">

            <Image Source="/Assets/Icons/IcCorrecto.png"
                   Width="70"
                   Height="70"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,18"/>

            <TextBlock x:Name="TxtTitulo"
                       Text="Docente creado"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="Black"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <Button Content="Salir"
                    Width="165"
                    Height="36"
                    Background="White"
                    Foreground="#9B9B9B"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    FontSize="14"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="BtnSalir_Click"/>
        </StackPanel>
    </Border>
</Window>