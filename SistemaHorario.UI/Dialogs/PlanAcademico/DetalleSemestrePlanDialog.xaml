<Window x:Class="SistemaHorario.UI.Dialogs.PlanAcademico.DetalleSemestrePlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Background="White"
            CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              Opacity="0.24"
                              BlurRadius="18"
                              ShadowDepth="2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="122"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="74"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#0878B4"
                    CornerRadius="12,12,0,0"
                    Padding="18">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding TituloSemestre, Mode=OneWay}"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="White"
                               TextAlignment="Center"/>

                    <TextBlock Text="{Binding ResumenSemestre, Mode=OneWay}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>

                    <TextBlock Text="{Binding JornadaSemestre, Mode=OneWay}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="#F4F7FA"
                    Padding="16"
                    Visibility="{Binding EstaEditando, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="54"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="CmbMateriasDisponibles"
                              Grid.Column="0"
                              ItemsSource="{Binding MateriasDisponibles, Mode=OneWay}"
                              SelectedItem="{Binding MateriaSeleccionada, Mode=TwoWay}"
                              DisplayMemberPath="Nombre"
                              Height="38"
                              FontSize="14"
                              Padding="8,0"
                              VerticalContentAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="+"
                            Style="{StaticResource IconButtonStyle}"
                            Background="#67A734"
                            HorizontalAlignment="Right"
                            Click="AgregarMateria_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          Background="#F1F1F1">

                <ItemsControl ItemsSource="{Binding Semestre.Materias, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="20,14"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="0,0,0,1"
                                    Background="#EAEAEA">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Nombre, Mode=OneWay}"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="#111111"
                                                   TextWrapping="Wrap"/>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,4,0,0">
                                            <TextBlock Text="Código: "
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#111111"/>

                                            <TextBlock Text="{Binding Codigo, Mode=OneWay}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#111111"/>

                                            <TextBlock Text=" · Créditos: "
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#111111"/>

                                            <TextBlock Text="{Binding Creditos, Mode=OneWay}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#111111"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="-"
                                            Width="38"
                                            Height="38"
                                            Background="#D92D20"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontSize="22"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            Visibility="{Binding DataContext.EstaEditando, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"
                                            CommandParameter="{Binding}"
                                            Click="QuitarMateria_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="3"
                  Background="White">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Button Content="↩"
                            Style="{StaticResource IconButtonStyle}"
                            Background="#2D9CDB"
                            Margin="0,0,12,0"
                            Click="Volver_Click"/>

                    <Button Content="✎"
                            Style="{StaticResource IconButtonStyle}"
                            Background="#2D9CDB"
                            Margin="0,0,12,0"
                            Click="Editar_Click"/>

                    <Button Content="Guardar"
                            Width="112"
                            Height="42"
                            Background="#67A734"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Visibility="{Binding EstaEditando, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Click="GuardarCambios_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>