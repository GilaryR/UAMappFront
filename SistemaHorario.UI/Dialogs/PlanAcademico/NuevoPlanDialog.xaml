<Window x:Class="SistemaHorario.UI.Dialogs.PlanAcademico.NuevoPlanAcademicoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo plan académico"
        Width="430"
        Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Border Padding="24"
            Background="White">

        <StackPanel>

            <TextBlock Text="Nuevo plan académico"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,22"/>

            <TextBlock Text="Jornada"
                       FontWeight="SemiBold"/>

            <ComboBox x:Name="CmbJornada"
                      Height="36"
                      Margin="0,8,0,18"
                      SelectedIndex="0">
                <ComboBoxItem Content="Diurna"/>
                <ComboBoxItem Content="Nocturna"/>
            </ComboBox>

            <TextBlock Text="Cantidad de semestres"
                       FontWeight="SemiBold"/>

            <ComboBox x:Name="CmbCantidadSemestres"
                      Height="36"
                      Margin="0,8,0,28"
                      SelectedIndex="0">
                <ComboBoxItem Content="10"/>
                <ComboBoxItem Content="12"/>
            </ComboBox>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Cancelar"
                        Width="110"
                        Height="38"
                        Margin="0,0,12,0"
                        Click="BtnCancelar_Click"/>

                <Button Content="Crear"
                        Width="110"
                        Height="38"
                        Background="#006AA6"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="BtnCrear_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>