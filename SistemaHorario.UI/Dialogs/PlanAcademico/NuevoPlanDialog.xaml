<Window x:Class="SistemaHorario.UI.Dialogs.PlanAcademico.NuevoPlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        Height="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Border Background="White"
            CornerRadius="14"
            Padding="30">

        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              Opacity="0.22"
                              BlurRadius="18"
                              ShadowDepth="2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,24">
                <TextBlock Text="Nuevo Plan Académico"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#111111"/>

                <TextBlock Text="Selecciona la cantidad de semestres y la jornada inicial del plan."
                           FontSize="14"
                           Foreground="#667085"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Cantidad de semestres"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#111111"
                           Margin="0,0,0,8"/>

                <ComboBox x:Name="CmbCantidadSemestres"
                          Height="42"
                          FontSize="15"
                          SelectedIndex="2"
                          Margin="0,0,0,20">
                    <ComboBoxItem Content="8 semestres" Tag="8"/>
                    <ComboBoxItem Content="9 semestres" Tag="9"/>
                    <ComboBoxItem Content="10 semestres" Tag="10"/>
                    <ComboBoxItem Content="11 semestres" Tag="11"/>
                    <ComboBoxItem Content="12 semestres" Tag="12"/>
                </ComboBox>

                <TextBlock Text="Jornada"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#111111"
                           Margin="0,0,0,8"/>

                <ComboBox x:Name="CmbJornada"
                          Height="42"
                          FontSize="15"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Por definir"/>
                    <ComboBoxItem Content="Diurna"/>
                    <ComboBoxItem Content="Nocturna"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,28,0,0">

                <Button Content="Cancelar"
                        Width="120"
                        Height="42"
                        Background="#D1D5DB"
                        Foreground="#111111"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Margin="0,0,12,0"
                        Click="BtnCancelar_Click"/>

                <Button Content="Continuar"
                        Width="135"
                        Height="42"
                        Background="#67A734"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BtnContinuar_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>