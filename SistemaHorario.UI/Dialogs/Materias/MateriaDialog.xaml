<Window x:Class="SistemaHorario.UI.Dialogs.Materias.MateriaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Materia"
        Width="760"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Border Background="White"
            CornerRadius="10"
            Padding="24">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- Formulario -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="74"/>
                    <RowDefinition Height="74"/>
                    <RowDefinition Height="74"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Código -->
                <StackPanel Grid.Row="0"
                            Grid.Column="0">
                    <TextBlock Text="Código *"
                               FontWeight="Bold"
                               FontSize="15"
                               Foreground="Black"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="TxtCodigo"
                             Height="34"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Padding="10,5"/>
                </StackPanel>

                <!-- Nombre -->
                <StackPanel Grid.Row="0"
                            Grid.Column="2">
                    <TextBlock Text="Nombre *"
                               FontWeight="Bold"
                               FontSize="15"
                               Foreground="Black"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="TxtNombre"
                             Height="34"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Padding="10,5"/>
                </StackPanel>

                <!-- Créditos -->
                <StackPanel Grid.Row="1"
                            Grid.Column="0">
                    <TextBlock Text="Créditos *"
                               FontWeight="Bold"
                               FontSize="15"
                               Foreground="Black"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="TxtCreditos"
                             Height="34"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Padding="10,5"/>
                </StackPanel>

                <!-- Intensidad -->
                <StackPanel Grid.Row="1"
                            Grid.Column="2">
                    <TextBlock Text="Intensidad horaria (horas/semana) *"
                               FontWeight="Bold"
                               FontSize="15"
                               Foreground="Black"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="TxtIntensidad"
                             Height="34"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Padding="10,5"/>
                </StackPanel>

                <!-- Semestre -->
                <StackPanel Grid.Row="2"
                            Grid.Column="0">
                    <TextBlock Text="Semestre *"
                               FontWeight="Bold"
                               FontSize="15"
                               Foreground="Black"
                               Margin="0,0,0,8"/>

                    <ComboBox x:Name="CmbSemestre"
                              Height="34"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Padding="8,4">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="6"/>
                        <ComboBoxItem Content="7"/>
                        <ComboBoxItem Content="8"/>
                        <ComboBoxItem Content="9"/>
                        <ComboBoxItem Content="10"/>
                    </ComboBox>
                </StackPanel>

                <!-- Cantidad de grupos -->
                <StackPanel Grid.Row="2"
                            Grid.Column="2">
                    <TextBlock Text="Cantidad de grupos *"
                               FontWeight="Bold"
                               FontSize="15"
                               Foreground="Black"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="TxtCantidadGrupos"
                             Height="34"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Padding="10,5"/>
                </StackPanel>

                <!-- Prerrequisitos -->
                <StackPanel Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="3">

                    <TextBlock Text="Prerrequisitos"
                               FontWeight="Bold"
                               FontSize="15"
                               Foreground="Black"
                               Margin="0,0,0,8"/>

                    <Border BorderBrush="#DADADA"
                            BorderThickness="1"
                            CornerRadius="5"
                            MinHeight="92"
                            Padding="10">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>

                            <!-- Chips seleccionados -->
                            <WrapPanel x:Name="PanelPrerrequisitos"
                                       Grid.Column="0"
                                       VerticalAlignment="Top"/>

                            <!-- Botón agregar -->
                            <Button x:Name="BtnMostrarPrerrequisitos"
                                    Grid.Column="1"
                                    Content="+"
                                    Width="34"
                                    Height="34"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="BtnMostrarPrerrequisitos_Click"/>

                            <!-- Lista desplegable -->
                            <Popup x:Name="PopupPrerrequisitos"
                                   PlacementTarget="{Binding ElementName=PanelPrerrequisitos}"
                                   Placement="Bottom"
                                   StaysOpen="False">

                                <Border Background="#F2F2F2"
                                        Width="280"
                                        Padding="6">

                                    <ItemsControl x:Name="ListaPrerrequisitos">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="34"
                                                      Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="34"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Nombre}"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"
                                                               Margin="8,0,0,0"/>

                                                    <Button Grid.Column="1"
                                                            Content="+"
                                                            FontWeight="Bold"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Click="BtnAgregarPrerrequisito_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Botones -->
            <Grid Grid.Row="1"
                  VerticalAlignment="Bottom">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnCancelar"
                        Grid.Column="1"
                        Content="Cancelar"
                        Height="42"
                        Background="White"
                        Foreground="#9A9A9A"
                        BorderBrush="#DADADA"
                        BorderThickness="1"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"
                        Click="BtnCancelar_Click"/>

                <Button x:Name="BtnGuardar"
                        Grid.Column="3"
                        Content="Guardar"
                        Height="42"
                        Background="#006AA6"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"
                        Click="BtnGuardar_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>