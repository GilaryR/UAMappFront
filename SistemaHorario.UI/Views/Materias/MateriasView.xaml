<UserControl x:Class="SistemaHorario.UI.Views.Materias.MateriasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SistemaHorario.UI.Controls">

    <Grid Background="#F4F7FA">

        <StackPanel>

            <!-- Encabezado -->
            <Grid Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Gestión de materias"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111111"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="+  Agregar materia"
                        Height="38"
                        Background="#006AA6"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BtnAgregarMateria_Click"/>
            </Grid>

            <!-- Contenedor -->
            <Border Background="White"
                    CornerRadius="12"
                    Padding="18">

                <StackPanel>

                    <!-- Filtros -->
                    <Grid Margin="0,0,0,16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <controls:SearchBox x:Name="SearchBoxMaterias"
                                            Grid.Column="0"
                                            Placeholder="Buscar por código o nombre"
                                            BusquedaCambiada="SearchBoxMaterias_BusquedaCambiada"/>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Semestre"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="0,0,0,4"/>

                            <ComboBox x:Name="CmbSemestre"
                                      Height="34"
                                      SelectionChanged="CmbSemestre_SelectionChanged">

                                <ComboBoxItem Content="Todos"
                                              IsSelected="True"/>

                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="6"/>
                                <ComboBoxItem Content="7"/>
                                <ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="9"/>
                                <ComboBoxItem Content="10"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4">

                            <TextBlock Text="Estado"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="0,0,0,4"/>

                            <ComboBox x:Name="CmbEstado"
                                      Height="34"
                                      SelectionChanged="CmbEstado_SelectionChanged">

                                <ComboBoxItem Content="Todos"
                                              IsSelected="True"/>

                                <ComboBoxItem Content="Activa"/>
                                <ComboBoxItem Content="Inactiva"/>
                            </ComboBox>
                        </StackPanel>

                        <Button Grid.Column="6"
                                Content="Limpiar filtros"
                                Height="34"
                                Background="#006AA6"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                VerticalAlignment="Bottom"
                                Click="BtnLimpiarFiltros_Click"/>
                    </Grid>

                    <!-- Tabla -->
                    <DataGrid x:Name="TablaMaterias"
                              ItemsSource="{Binding MateriasFiltradas}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              BorderThickness="0"
                              RowHeight="42"
                              ColumnHeaderHeight="38"
                              FontSize="13"
                              MaxHeight="520"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Resources>

                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"
                                        Value="#F1F1F1"/>

                                <Setter Property="FontWeight"
                                        Value="Bold"/>

                                <Setter Property="BorderThickness"
                                        Value="0"/>

                                <Setter Property="HorizontalContentAlignment"
                                        Value="Center"/>
                            </Style>

                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness"
                                        Value="0"/>

                                <Setter Property="Padding"
                                        Value="4"/>

                                <Setter Property="HorizontalContentAlignment"
                                        Value="Center"/>
                            </Style>

                        </DataGrid.Resources>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Código"
                                                Binding="{Binding Codigo}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Nombre"
                                                Binding="{Binding Nombre}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="Créditos"
                                                Binding="{Binding Creditos}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Intensidad"
                                                Binding="{Binding IntensidadHorariaSemanal}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Semestre"
                                                Binding="{Binding Semestre}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Can grupos"
                                                Binding="{Binding CantidadGrupos}"
                                                Width="*"/>

                            <!-- Estado -->
                            <DataGridTemplateColumn Header="Estado"
                                                    Width="*">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>

                                        <Border CornerRadius="6"
                                                Padding="8,3"
                                                HorizontalAlignment="Center">

                                            <Border.Style>
                                                <Style TargetType="Border">

                                                    <Setter Property="Background"
                                                            Value="#B9EFC2"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding Activa}"
                                                                     Value="False">

                                                            <Setter Property="Background"
                                                                    Value="#FED227"/>
                                                        </DataTrigger>

                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock Text="{Binding EstadoTexto}"
                                                       FontWeight="Bold"
                                                       FontSize="12">

                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">

                                                        <Setter Property="Foreground"
                                                                Value="#1A9E3B"/>

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding Activa}"
                                                                         Value="False">

                                                                <Setter Property="Foreground"
                                                                        Value="#D6AB05"/>
                                                            </DataTrigger>

                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>

                                            </TextBlock>
                                        </Border>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Acciones -->
                            <DataGridTemplateColumn Header="Acciones"
                                                    Width="150">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">

                                            <Button Content="✎"
                                                    Width="26"
                                                    Height="24"
                                                    Margin="2"
                                                    Background="#73AFE0"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Editar"
                                                    Click="BtnEditar_Click"/>

                                            <!-- Inactivar: solo aparece cuando la materia está activa -->
                                            <Button Content="⛔"
                                                    Width="26"
                                                    Height="24"
                                                    Margin="2"
                                                    Background="#EBB6B6"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Inactivar"
                                                    Click="BtnInactivar_Click">

                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Activa}"
                                                                         Value="False">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Reactivar: solo aparece cuando la materia está inactiva -->
                                            <Button Content="↻"
                                                    Width="26"
                                                    Height="24"
                                                    Margin="2"
                                                    Background="#B9EFC2"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Reactivar"
                                                    Click="BtnReactivar_Click">

                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Activa}"
                                                                         Value="False">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="👁"
                                                    Width="26"
                                                    Height="24"
                                                    Margin="2"
                                                    Background="#DDCE73"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Ver"
                                                    Click="BtnVer_Click"/>
                                        </StackPanel>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Resumen -->
                    <TextBlock x:Name="TxtResumen"
                               Margin="4,14,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#7A7A7A"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>