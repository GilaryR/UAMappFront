<UserControl x:Class="SistemaHorario.UI.Views.GruposAcademicos.GruposAcademicosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1400">

    <UserControl.Resources>

        <Style x:Key="BotonAccionTabla" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="BotonPrincipal" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="Background" Value="#0B7FB4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <Style x:Key="BotonSecundario" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="Background" Value="#D1D5DB"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="#EEF0F2">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="34,28,34,28">

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Grupos Académicos"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#111111"/>

                        <TextBlock Text="Administra los grupos académicos del programa."
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#8A8F98"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Nuevo grupo"
                            Style="{StaticResource BotonPrincipal}"
                            Width="150"
                            Click="NuevoGrupo_Click"/>
                </Grid>

                <Border Background="White"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,0,0,16">

                    <StackPanel Orientation="Horizontal">

                        <TextBox x:Name="TxtCodigoGrupo"
                                 Width="250"
                                 Height="34"
                                 FontSize="14"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding CodigoGrupoFiltro, UpdateSourceTrigger=PropertyChanged}"/>

                        <ComboBox x:Name="CmbEstado"
                                  Width="170"
                                  Height="34"
                                  FontSize="14"
                                  Margin="12,0,0,0"
                                  SelectedValuePath="Content"
                                  SelectedValue="{Binding EstadoFiltro, Mode=TwoWay}">
                            <ComboBoxItem Content="Todos"/>
                            <ComboBoxItem Content="Activa"/>
                            <ComboBoxItem Content="Inactiva"/>
                        </ComboBox>

                        <ComboBox x:Name="CmbJornada"
                                  Width="170"
                                  Height="34"
                                  FontSize="14"
                                  Margin="12,0,0,0"
                                  SelectedValuePath="Content"
                                  SelectedValue="{Binding JornadaFiltro, Mode=TwoWay}">
                            <ComboBoxItem Content="Todas"/>
                            <ComboBoxItem Content="Diurno"/>
                            <ComboBoxItem Content="Nocturno"/>
                        </ComboBox>

                        <Button Content="Filtrar"
                                Style="{StaticResource BotonPrincipal}"
                                Margin="12,0,0,0"
                                Click="Filtrar_Click"/>

                        <Button Content="Limpiar"
                                Style="{StaticResource BotonSecundario}"
                                Margin="10,0,0,0"
                                Click="Limpiar_Click"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="8"
                        Padding="18">

                    <StackPanel>

                        <TextBlock Text="Asignación de materias por grupo"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#8A8F98"
                                   Margin="0,0,0,12"/>

                        <DataGrid ItemsSource="{Binding GruposPaginaActual}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="42"
                                  ColumnHeaderHeight="34"
                                  FontSize="14"
                                  BorderThickness="0"
                                  Background="White"
                                  HorizontalGridLinesBrush="#111111"
                                  HorizontalScrollBarVisibility="Auto">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                    <Setter Property="Foreground" Value="#111111"/>
                                    <Setter Property="Padding" Value="7,0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="5"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Grupo"
                                                    Binding="{Binding NombreGrupo}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Código"
                                                    Binding="{Binding Codigo}"
                                                    Width="90"/>

                                <DataGridTemplateColumn Header="Jornada"
                                                        Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="5"
                                                    Padding="9,5"
                                                    HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#CFE8FA"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Jornada}" Value="Nocturno">
                                                                <Setter Property="Background" Value="#C2B0ED"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <TextBlock Text="{Binding Jornada}"
                                                           FontWeight="Bold"
                                                           FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#0077B6"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Jornada}" Value="Nocturno">
                                                                    <Setter Property="Foreground" Value="#535BC6"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Materia"
                                                    Binding="{Binding Materia}"
                                                    Width="160"/>

                                <DataGridTextColumn Header="Horario"
                                                    Binding="{Binding Horario}"
                                                    Width="150"/>

                                <DataGridTextColumn Header="Estudiantes"
                                                    Binding="{Binding EstudiantesTexto}"
                                                    Width="95"/>

                                <DataGridTextColumn Header="Tipo"
                                                    Binding="{Binding Tipo}"
                                                    Width="90"/>

                                <DataGridTemplateColumn Header="Estado"
                                                        Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#D4F8DD"
                                                    CornerRadius="5"
                                                    Padding="9,5"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Estado}"
                                                           Foreground="#008A30"
                                                           FontWeight="Bold"
                                                           FontSize="13"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Acciones"
                                                        Width="112">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="👁"
                                                        Background="#E4D36C"
                                                        Foreground="#111111"
                                                        Style="{StaticResource BotonAccionTabla}"
                                                        CommandParameter="{Binding}"
                                                        Click="VerGrupo_Click"/>

                                                <Button Content="✎"
                                                        Background="#78B8E6"
                                                        Foreground="#111111"
                                                        Style="{StaticResource BotonAccionTabla}"
                                                        CommandParameter="{Binding}"
                                                        Click="EditarGrupo_Click"/>

                                                <Button Content="🗑"
                                                        Background="#F0B6B6"
                                                        Foreground="#111111"
                                                        Style="{StaticResource BotonAccionTabla}"
                                                        CommandParameter="{Binding}"
                                                        Click="EliminarGrupo_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnAnterior"
                                    Grid.Column="0"
                                    Content="Anterior"
                                    Style="{StaticResource BotonSecundario}"
                                    Width="120"
                                    Click="Anterior_Click"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding TextoPagina}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#4B5563"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <Button x:Name="BtnSiguiente"
                                    Grid.Column="2"
                                    Content="Siguiente"
                                    Style="{StaticResource BotonPrincipal}"
                                    Width="120"
                                    Click="Siguiente_Click"/>
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>