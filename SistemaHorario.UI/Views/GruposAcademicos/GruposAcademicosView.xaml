<UserControl x:Class="SistemaHorario.UI.Views.GruposAcademicos.GruposAcademicosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1400">

    <UserControl.Resources>
        <Style x:Key="BotonAccionTabla" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="BotonPrincipal" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="Background" Value="#0B7FB4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <Style x:Key="BotonSecundario" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="Background" Value="#D1D5DB"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F4F7FA"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="Inactivo">
                    <Setter Property="Background" Value="#FEF2F2"/>
                    <Setter Property="Foreground" Value="#991B1B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#EEF0F2">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28">

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Grupos Académicos"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#111111"/>
                        <TextBlock Text="Administra los grupos por jornada, semestre, tipo y cupos."
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#8A8F98"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Nuevo grupo"
                            Style="{StaticResource BotonPrincipal}"
                            Width="150"
                            VerticalAlignment="Center"
                            Click="NuevoGrupo_Click"/>
                </Grid>

                <Border Background="White" CornerRadius="14" Padding="18" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Buscar grupo"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtCodigoGrupo"
                                     Height="38"
                                     FontSize="14"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding CodigoGrupoFiltro, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Estado"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbEstado"
                                      Height="38"
                                      FontSize="14"
                                      SelectedValuePath="Content"
                                      SelectedValue="{Binding EstadoFiltro, Mode=TwoWay}">
                                <ComboBoxItem Content="Todos"/>
                                <ComboBoxItem Content="Activo"/>
                                <ComboBoxItem Content="Inactivo"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Jornada"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbJornada"
                                      Height="38"
                                      FontSize="14"
                                      SelectedValuePath="Content"
                                      SelectedValue="{Binding JornadaFiltro, Mode=TwoWay}">
                                <ComboBoxItem Content="Todas"/>
                                <ComboBoxItem Content="Diurna"/>
                                <ComboBoxItem Content="Nocturna"/>
                            </ComboBox>
                        </StackPanel>

                        <Button Grid.Column="6"
                                Content="Filtrar"
                                Style="{StaticResource BotonPrincipal}"
                                VerticalAlignment="Bottom"
                                Click="Filtrar_Click"/>

                        <Button Grid.Column="8"
                                Content="Limpiar"
                                Style="{StaticResource BotonSecundario}"
                                VerticalAlignment="Bottom"
                                Click="Limpiar_Click"/>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="14" BorderBrush="#D9E2EC" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Secciones académicas registradas"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,12"/>

                        <DataGrid ItemsSource="{Binding GruposPaginaActual}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  RowHeight="46"
                                  ColumnHeaderHeight="44"
                                  FontSize="13"
                                  BorderThickness="0"
                                  Background="White"
                                  AlternatingRowBackground="#FAFBFC"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  MaxHeight="520">

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="1*"/>
                                <DataGridTextColumn Header="Grupo" Binding="{Binding NombreGrupo}" Width="2*"/>

                                <DataGridTemplateColumn Header="Jornada" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="9,4" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#CFE8FA"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Jornada}" Value="Nocturna">
                                                                <Setter Property="Background" Value="#C2B0ED"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Jornada}" FontWeight="Bold" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#0077B6"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Jornada}" Value="Nocturna">
                                                                    <Setter Property="Foreground" Value="#535BC6"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Semestre" Binding="{Binding NumeroSemestre}" Width="0.8*"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="1*"/>
                                <DataGridTextColumn Header="Estudiantes" Binding="{Binding EstudiantesTexto}" Width="1*"/>

                                <DataGridTemplateColumn Header="Estado" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="9,4" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#D4F8DD"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Estado}" Value="Inactivo">
                                                                <Setter Property="Background" Value="#FECACA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Estado}" FontWeight="Bold" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#008A30"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Estado}" Value="Inactivo">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Acciones" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="👁" Background="#E4D36C" Foreground="#111111"
                                                        Style="{StaticResource BotonAccionTabla}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Ver"
                                                        Click="VerGrupo_Click"/>
                                                <Button Content="✎" Background="#78B8E6" Foreground="#111111"
                                                        Style="{StaticResource BotonAccionTabla}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Editar"
                                                        Click="EditarGrupo_Click"/>
                                                <Button Content="↻" Background="#F0B6B6" Foreground="#111111"
                                                        Style="{StaticResource BotonAccionTabla}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Cambiar estado"
                                                        Click="EliminarGrupo_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnAnterior" Grid.Column="0" Content="Anterior"
                                    Style="{StaticResource BotonSecundario}" Width="120"
                                    Click="Anterior_Click"/>

                            <TextBlock Grid.Column="1" Text="{Binding TextoPagina}"
                                       FontSize="14" FontWeight="Bold" Foreground="#4B5563"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Button x:Name="BtnSiguiente" Grid.Column="2" Content="Siguiente"
                                    Style="{StaticResource BotonPrincipal}" Width="120"
                                    Click="Siguiente_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
