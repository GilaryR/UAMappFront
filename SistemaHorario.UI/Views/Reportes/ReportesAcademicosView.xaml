<UserControl x:Class="SistemaHorario.UI.Views.Reportes.ReportesAcademicosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SistemaHorario.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1200">

    <Grid Background="White">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Reportes Académicos"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#111111"/>

                        <TextBlock Text="Consulta, vista previa y descarga de reportes de horarios, docentes y conflictos."
                                   FontSize="15"
                                   Foreground="#6B7280"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Actualizar"
                            Width="180"
                            Height="42"
                            Background="#006AA6"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnActualizar_Click"/>
                </Grid>

                <Border Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18"
                        Margin="0,0,0,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtBusqueda"
                                 Grid.Column="0"
                                 Height="34"
                                 FontSize="14"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Buscar por tipo, detalle, periodo o estado"/>

                        <ComboBox x:Name="CmbTipoReporte"
                                  Grid.Column="2"
                                  Height="34"
                                  FontSize="14"/>

                        <DatePicker x:Name="DpFecha"
                                    Grid.Column="4"
                                    Height="34"
                                    FontSize="14"/>

                        <Button Grid.Column="6"
                                Content="Filtrar"
                                Height="34"
                                Background="#006AA6"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnFiltrar_Click"/>

                        <Button Grid.Column="8"
                                Content="Limpiar"
                                Height="34"
                                Background="#E5E7EB"
                                Foreground="#111111"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnLimpiar_Click"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="TxtMensajeEstado"
                           Text=""
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#6B7280"
                           Margin="0,0,0,12"
                           Visibility="Collapsed"/>

                <controls:TablaPaginada x:Name="TablaReportes"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
