<UserControl x:Class="SistemaHorario.UI.Views.Shell.MainShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:SistemaHorario.UI.Views.Shell">

    <Grid Background="#F4F7FA">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <shell:SidebarView x:Name="sidebarView"
                           Grid.Column="0"
                           Grid.Row="0"
                           Grid.RowSpan="2"
                           Panel.ZIndex="1"/>

        <!-- TopBar -->
        <shell:TopBarView x:Name="topBarView"
                          Grid.Column="1"
                          Grid.Row="0"
                          Panel.ZIndex="2"/>

        <!-- Contenido principal -->
        <Border Grid.Column="1"
                Grid.Row="1"
                Background="#F4F7FA"
                Padding="24"
                Panel.ZIndex="0">

            <ContentControl x:Name="ContentArea"/>
        </Border>

        <!-- Menú desplegable del usuario -->
        <shell:UserMenuView x:Name="userMenuView"
                            Grid.Column="1"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,60,18,0"
                            Panel.ZIndex="99"/>
    </Grid>
</UserControl>