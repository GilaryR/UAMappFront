<UserControl x:Class="SistemaHorario.UI.Views.Horarios.VistaPreviaHorarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Background="#F4F7FA">

            <StackPanel>

                <TextBlock x:Name="TxtTitulo"
                       Text="Vista previa para aprobación"
                       FontSize="30"
                       FontWeight="Bold"
                       Margin="0,0,0,18"/>

                <Border Background="White"
                    CornerRadius="14"
                    Padding="18">

                    <StackPanel>

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="TxtNombreHorario"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                                <TextBlock x:Name="TxtDetalleHorario"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       Margin="0,4,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                Background="#D8F8DD"
                                CornerRadius="6"
                                Padding="10"
                                HorizontalAlignment="Right">

                                <TextBlock Text="Sin solapes"
                                       Foreground="Green"
                                       FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <Grid x:Name="GridHorario"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,18,0,0">

                            <Button x:Name="BtnAprobar"
                                    Content="APROBAR HORARIO"
                                    Width="180"
                                    Height="38"
                                    Background="#159A22"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    Margin="0,0,16,0"
                                    Click="BtnAprobar_Click"/>

                            <Button x:Name="BtnEditar"
                                    Content="EDITAR"
                                    Width="140"
                                    Height="38"
                                    Background="#006AA6"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    Margin="0,0,16,0"
                                    Click="BtnEditar_Click"/>

                            <Button x:Name="BtnRechazar"
                                    Content="RECHAZAR"
                                    Width="140"
                                    Height="38"
                                    Background="#B00020"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    Margin="0,0,16,0"
                                    Click="BtnRechazar_Click"/>

                            <Button x:Name="BtnSalir"
                                    Content="SALIR"
                                    Width="140"
                                    Height="38"
                                    Background="#E5E7EB"
                                    Foreground="#111827"
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    Click="BtnSalir_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>