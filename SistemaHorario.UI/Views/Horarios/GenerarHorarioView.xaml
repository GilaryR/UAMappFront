<UserControl x:Class="SistemaHorario.UI.Views.Horarios.GenerarHorarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Background="#F4F7FA">

        <Border Background="White"
                CornerRadius="16"
                Padding="30">

            <StackPanel>

                <TextBlock Text="Generar horario"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <TextBlock Text="Configure los parámetros solicitados por el backend para generar el horario"
                           Margin="0,8,0,30"
                           FontSize="15"
                           Foreground="#6B7280"/>

                <Border Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24">

                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Grupo académico -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Grupo académico"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           Margin="0,0,0,8"/>

                                <ComboBox x:Name="CmbGrupo"
                                          Height="42"
                                          FontSize="14"
                                          DisplayMemberPath="DisplayTexto"/>
                            </StackPanel>

                            <!-- Duración -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Duración del bloque"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           Margin="0,0,0,8"/>

                                <ComboBox x:Name="CmbDuracion"
                                          Height="42"
                                          FontSize="14">

                                    <ComboBoxItem Content="60 minutos"
                                                  Tag="60"
                                                  IsSelected="True"/>

                                    <ComboBoxItem Content="120 minutos"
                                                  Tag="120"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Hora inicio -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Hora inicio"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           Margin="0,0,0,8"/>

                                <ComboBox x:Name="CmbHoraInicio"
                                          Height="42"
                                          FontSize="14">

                                    <ComboBoxItem Content="07:00"
                                                  IsSelected="True"/>
                                    <ComboBoxItem Content="08:00"/>
                                    <ComboBoxItem Content="09:00"/>
                                    <ComboBoxItem Content="10:00"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Hora final -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Hora final"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           Margin="0,0,0,8"/>

                                <ComboBox x:Name="CmbHoraFinal"
                                          Height="42"
                                          FontSize="14">

                                    <ComboBoxItem Content="18:00"/>
                                    <ComboBoxItem Content="22:30"
                                                  IsSelected="True"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1"
                                   Fill="#E5E7EB"
                                   Margin="0,24"/>

                        <!-- Días requeridos por backend -->
                        <StackPanel>

                            <TextBlock Text="Días habilitados"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Margin="0,0,0,18"/>

                            <WrapPanel>

                                <CheckBox x:Name="ChkLunes"
                                          Content="Lunes"
                                          IsChecked="True"
                                          Margin="0,0,24,0"/>

                                <CheckBox x:Name="ChkMartes"
                                          Content="Martes"
                                          IsChecked="True"
                                          Margin="0,0,24,0"/>

                                <CheckBox x:Name="ChkMiercoles"
                                          Content="Miércoles"
                                          IsChecked="True"
                                          Margin="0,0,24,0"/>

                                <CheckBox x:Name="ChkJueves"
                                          Content="Jueves"
                                          IsChecked="True"
                                          Margin="0,0,24,0"/>

                                <CheckBox x:Name="ChkViernes"
                                          Content="Viernes"
                                          IsChecked="True"
                                          Margin="0,0,24,0"/>

                                <CheckBox x:Name="ChkSabado"
                                          Content="Sábado"
                                          IsChecked="True"/>
                            </WrapPanel>
                        </StackPanel>

                        <Button x:Name="BtnGenerar"
                                Content="Generar horario"
                                Width="220"
                                Height="46"
                                Margin="0,35,0,0"
                                HorizontalAlignment="Right"
                                Background="#0F6CBD"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="BtnGenerar_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>