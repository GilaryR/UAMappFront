<UserControl x:Class="SistemaHorario.UI.Views.Perfil.PerfilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F4F7FA">

        <StackPanel>

            <TextBlock Text="Mi perfil"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="Black"
                       Margin="0,0,0,24"/>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="34"
                    Width="860"
                    HorizontalAlignment="Left">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Foto -->
                    <StackPanel Grid.Column="0"
                                HorizontalAlignment="Center">

                        <Image x:Name="ImgPerfil"
                               Source="/Assets/Images/ImgUsuario.png"
                               Width="170"
                               Height="170"
                               Stretch="Uniform"
                               Margin="0,0,0,18"/>

                        <Button Width="145"
                                Height="32"
                                Background="White"
                                BorderBrush="#DADADA"
                                Cursor="Hand"
                                Click="BtnCambiarFoto_Click">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                <Image Source="/Assets/Icons/IcCambiar.png"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,6,0"/>

                                <TextBlock Text="Cambiar foto"
                                           Foreground="#006AA6"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Button Width="171"
                                Height="38"
                                Margin="0,140,0,0"
                                Background="#B80000"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnCerrarSesion_Click">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                <Image Source="/Assets/Icons/IcCerrar.png"
                                       Width="27"
                                       Height="22"
                                       Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform AngleY="-6.557"/>
                                            <RotateTransform/>
                                            <TranslateTransform Y="-1.552"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                                <TextBlock Text="Cerrar sesión"
                                           FontWeight="Bold" RenderTransformOrigin="1.045,6.626"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Separador -->
                    <Rectangle Grid.Column="1"
                               Fill="#E5E7EB"
                               Margin="0,0,28,0"/>

                    <!-- Datos -->
                    <Grid Grid.Column="2"
                          Margin="35,0,0,0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="64"/>
                            <RowDefinition Height="64"/>
                            <RowDefinition Height="64"/>
                            <RowDefinition Height="64"/>
                            <RowDefinition Height="80"/>
                            <RowDefinition Height="70"/>
                        </Grid.RowDefinitions>

                        <!-- Nombre -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="/Assets/Icons/IcPerfilUs.png"
                                   Width="28"
                                   Height="28"/>

                            <TextBlock Grid.Column="1"
                                       Text="Nombre completo"
                                       FontWeight="Bold"
                                       Foreground="#8A8A8A"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="TxtNombre"
                                       Grid.Column="2"
                                       FontWeight="Bold"
                                       Foreground="#8A8A8A"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Correo -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="/Assets/Icons/IcCorreo.png"
                                   Width="28"
                                   Height="28"/>

                            <TextBlock Grid.Column="1"
                                       Text="Correo institucional"
                                       FontWeight="Bold"
                                       Foreground="#8A8A8A"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="TxtCorreo"
                                       Grid.Column="2"
                                       FontWeight="Bold"
                                       Foreground="#8A8A8A"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Rol -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="/Assets/Icons/IcRol.png"
                                   Width="28"
                                   Height="28"/>

                            <TextBlock Grid.Column="1"
                                       Text="Rol"
                                       FontWeight="Bold"
                                       Foreground="#8A8A8A"
                                       VerticalAlignment="Center"/>

                            <Border Grid.Column="2"
                                    Background="#DDF1FF"
                                    CornerRadius="5"
                                    Width="140"
                                    Padding="8,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">

                                <TextBlock x:Name="TxtRol"
                                           Foreground="#0074B8"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Teléfono -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="/Assets/Icons/IcTelefono.png"
                                   Width="28"
                                   Height="28"/>

                            <TextBlock Grid.Column="1"
                                       Text="Telefono"
                                       FontWeight="Bold"
                                       Foreground="#8A8A8A"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="TxtTelefono"
                                       Grid.Column="2"
                                       FontWeight="Bold"
                                       Foreground="#8A8A8A"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Facultad -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="/Assets/Icons/IcFacultad.png"
                                   Width="28"
                                   Height="28"/>

                            <TextBlock Grid.Column="1"
                                       Text="Facultad / Programa"
                                       FontWeight="Bold"
                                       Foreground="#8A8A8A"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="TxtFacultad"
                                       Grid.Column="2"
                                       FontWeight="Bold"
                                       Foreground="#8A8A8A"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Botones -->
                        <Grid Grid.Row="5"
                              VerticalAlignment="Bottom">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="230"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Height="38"
                                    Background="#006AA6"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="BtnEditarPerfil_Click">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <Image Source="/Assets/Icons/IcEditar.png"
                                           Width="18"
                                           Height="18"
                                           Margin="0,0,8,0"/>

                                    <TextBlock Text="Editar perfil"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Height="38"
                                    Background="White"
                                    BorderBrush="#006AA6"
                                    Foreground="#006AA6"
                                    Cursor="Hand"
                                    Click="BtnCambiarContrasena_Click" HorizontalAlignment="Left" Width="197" Margin="33,0,0,0">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <Image Source="/Assets/Icons/IcCambiarContra.png"
                                           Width="18"
                                           Height="18"
                                           Margin="0,0,8,0"/>

                                    <TextBlock Text="Cambiar contraseña"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>