<UserControl x:Class="SistemaHorario.UI.Views.Coordinadores.AgregarEditarCoordinadorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid Background="#F4F7FA">

		<Border Background="White"
                CornerRadius="12"
                Padding="24"
                Margin="24">

			<StackPanel>

				<TextBlock x:Name="TxtTitulo"
                           Text="Formulario posterior a verificación"
                           FontSize="30"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="40"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="18"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="18"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<StackPanel Grid.Row="0" Grid.Column="0">
						<TextBlock Text="Nombre completo"
                                   FontWeight="SemiBold"/>
						<TextBox x:Name="TxtNombre"
                                 Height="34"
                                 Margin="0,6,0,0"/>
					</StackPanel>

					<StackPanel Grid.Row="0" Grid.Column="2">
						<TextBlock Text="Cédula"
                                   FontWeight="SemiBold"/>
						<TextBox x:Name="TxtCedula"
                                 Height="34"
                                 Margin="0,6,0,0"/>
					</StackPanel>

					<StackPanel Grid.Row="2" Grid.Column="0">
						<TextBlock Text="Correo institucional"
                                   FontWeight="SemiBold"/>
						<TextBox x:Name="TxtCorreo"
                                 Height="34"
                                 Margin="0,6,0,0"/>
					</StackPanel>

					<StackPanel Grid.Row="2" Grid.Column="2">
						<TextBlock Text="Celular"
                                   FontWeight="SemiBold"/>
						<TextBox x:Name="TxtCelular"
                                 Height="34"
                                 Margin="0,6,0,0"/>
					</StackPanel>

					<StackPanel Grid.Row="4" Grid.Column="0">
						<TextBlock Text="Rol"
                                   FontWeight="SemiBold"/>
						<TextBox x:Name="TxtRol"
                                 Text="Coordinador"
                                 IsReadOnly="True"
                                 Height="34"
                                 Margin="0,6,0,0"
                                 FontWeight="SemiBold"
                                 TextAlignment="Center"/>
					</StackPanel>

					<StackPanel Grid.Row="4" Grid.Column="2">
						<TextBlock Text="Estado"
                                   FontWeight="SemiBold"/>
						<ComboBox x:Name="CmbEstado"
                                  Height="34"
                                  Margin="0,6,0,0">
							<ComboBoxItem Content="Activo"
                                          IsSelected="True"/>
							<ComboBoxItem Content="Inactivo"/>
						</ComboBox>
					</StackPanel>
				</Grid>

				<Button x:Name="BtnGuardar"
                        Content="Guardar"
                        Width="220"
                        Height="40"
                        Margin="0,70,0,0"
                        HorizontalAlignment="Left"
                        Background="#006AA6"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="BtnGuardar_Click"/>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>