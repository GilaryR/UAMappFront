<UserControl x:Class="SistemaHorario.UI.Views.Coordinadores.AgregarEditarCoordinadorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F4F7FA">
        <Border Background="White"
                CornerRadius="12"
                Padding="24"
                Margin="24">

            <StackPanel>
                <TextBlock x:Name="TxtTitulo"
                           Text="Agregar coordinador"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Los coordinadores inactivos no podrán iniciar sesión."
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0,0,0,22"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Nombre completo" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtNombre"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Cédula" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtCedula"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Correo institucional" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtCorreo"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Celular" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtCelular"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0">
                        <TextBlock Text="Rol" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtRol"
                                 Text="Coordinador"
                                 IsReadOnly="True"
                                 Height="36"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 FontWeight="SemiBold"
                                 TextAlignment="Center"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="2">
                        <TextBlock Text="Estado" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbEstado"
                                  Height="36"
                                  Margin="0,6,0,0">
                            <ComboBoxItem Content="Activo" IsSelected="True"/>
                            <ComboBoxItem Content="Inactivo"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="PnlContrasena"
                                Grid.Row="6"
                                Grid.Column="0">
                        <TextBlock Text="Contraseña inicial" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="PwdContrasena"
                                     Height="36"
                                     Margin="0,6,0,0"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="PnlAyudaContrasena"
                                Grid.Row="6"
                                Grid.Column="2"
                                VerticalAlignment="Bottom">
                        <TextBlock Text="Puedes dejar la contraseña sugerida o cambiarla antes de crear el coordinador."
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal"
                            Margin="0,60,0,0">
                    <Button x:Name="BtnGuardar"
                            Content="Guardar"
                            Width="180"
                            Height="42"
                            Background="#006AA6"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnGuardar_Click"/>

                    <Button x:Name="BtnCancelar"
                            Content="Cancelar"
                            Width="150"
                            Height="42"
                            Margin="12,0,0,0"
                            Background="#E5E7EB"
                            Foreground="#111827"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnCancelar_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
