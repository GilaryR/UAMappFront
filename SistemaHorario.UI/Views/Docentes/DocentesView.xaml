<UserControl x:Class="SistemaHorario.UI.Views.Docentes.DocentesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SistemaHorario.UI.Controls">

	<Grid Background="#F4F7FA">

		<ScrollViewer VerticalScrollBarVisibility="Auto">

			<StackPanel Margin="24">

				<TextBlock Text="Docentes"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#111827"
                           Margin="0,0,0,22"/>

				<Grid Margin="0,0,0,22">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="18"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="18"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="18"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<Border Grid.Column="0"
                            Background="White"
                            CornerRadius="14"
                            Padding="20">
						<StackPanel>
							<TextBlock Text="Total docentes"
                                       FontSize="14"
                                       Foreground="#6B7280"/>
							<TextBlock x:Name="TxtTotalDocentes"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="#111827"/>
						</StackPanel>
					</Border>

					<Border Grid.Column="2"
                            Background="White"
                            CornerRadius="14"
                            Padding="20">
						<StackPanel>
							<TextBlock Text="Activos"
                                       FontSize="14"
                                       Foreground="#6B7280"/>
							<TextBlock x:Name="TxtActivos"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="#1A9E3B"/>
						</StackPanel>
					</Border>

					<Border Grid.Column="4"
                            Background="White"
                            CornerRadius="14"
                            Padding="20">
						<StackPanel>
							<TextBlock Text="Inactivos"
                                       FontSize="14"
                                       Foreground="#6B7280"/>
							<TextBlock x:Name="TxtInactivos"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="#D6AB05"/>
						</StackPanel>
					</Border>

					<Border Grid.Column="6"
                            Background="White"
                            CornerRadius="14"
                            Padding="20">
						<StackPanel>
							<TextBlock Text="Disponibilidad registrada"
                                       FontSize="14"
                                       Foreground="#6B7280"/>
							<TextBlock x:Name="TxtDisponibles"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="#006AA6"/>
						</StackPanel>
					</Border>
				</Grid>

				<Border Background="White"
                        CornerRadius="14"
                        Padding="18"
                        Margin="0,0,0,18">

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="2*"/>
							<ColumnDefinition Width="18"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="18"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="12"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<controls:SearchBox x:Name="SearchDocentes"
                                            Placeholder="Buscar por nombre, identificación o correo"
                                            BusquedaCambiada="SearchDocentes_BusquedaCambiada"/>

						<StackPanel Grid.Column="2">
							<TextBlock Text="Estado"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

							<ComboBox x:Name="CmbEstadoFiltro"
                                      Height="38"
                                      SelectionChanged="CmbEstadoFiltro_SelectionChanged">
								<ComboBoxItem Content="Todos"
                                              IsSelected="True"/>
								<ComboBoxItem Content="Activo"/>
								<ComboBoxItem Content="Inactivo"/>
							</ComboBox>
						</StackPanel>

						<Button Grid.Column="4"
                                Content="Aplicar filtros"
                                Width="130"
                                Height="38"
                                Margin="0,22,0,0"
                                Background="#006AA6"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnAplicarFiltros_Click"/>

						<Button Grid.Column="6"
                                Content="Limpiar"
                                Width="100"
                                Height="38"
                                Margin="0,22,0,0"
                                Background="#E5E7EB"
                                Foreground="#111827"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnLimpiarFiltros_Click"/>
					</Grid>
				</Border>

				<controls:TablaPaginada x:Name="TablaDocentes"/>

				<Button Content="+ Agregar docente"
                        Width="210"
                        Height="42"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0"
                        Background="#006AA6"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnAgregarDocente_Click"/>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>