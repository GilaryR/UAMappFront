<UserControl x:Class="SistemaHorario.UI.Views.HistorialCambios.HistorialCambiosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid Background="#F4F7FA">

		<ScrollViewer VerticalScrollBarVisibility="Auto">

			<StackPanel Margin="24">

				<!-- TÍTULO -->
				<TextBlock Text="Historial de cambios"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#111827"
                           Margin="0,0,0,20"/>

				<!-- FILTROS -->
				<Border Background="White"
                        CornerRadius="14"
                        Padding="28"
                        Margin="0,0,0,24">

					<StackPanel>

						<Grid Margin="0,0,0,28">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="24"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="24"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="24"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<!-- USUARIO -->
							<StackPanel Grid.Column="0">
								<TextBlock Text="Usuario"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>

								<ComboBox x:Name="CmbUsuario"
                                          Height="40"
                                          FontSize="14"/>
							</StackPanel>

							<!-- MÓDULO -->
							<StackPanel Grid.Column="2">
								<TextBlock Text="Módulo"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>

								<ComboBox x:Name="CmbModulo"
                                          Height="40"
                                          FontSize="14"/>
							</StackPanel>

							<!-- FECHA DESDE -->
							<StackPanel Grid.Column="4">
								<TextBlock Text="Fecha desde"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>

								<DatePicker x:Name="DtpFechaDesde"
                                            Height="40"
                                            FontSize="14"/>
							</StackPanel>

							<!-- FECHA HASTA -->
							<StackPanel Grid.Column="6">
								<TextBlock Text="Fecha hasta"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>

								<DatePicker x:Name="DtpFechaHasta"
                                            Height="40"
                                            FontSize="14"/>
							</StackPanel>
						</Grid>

						<StackPanel Orientation="Horizontal">

							<Button x:Name="BtnFiltrar"
                                    Content="Filtrar"
                                    Width="190"
                                    Height="44"
                                    Background="#006AA6"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Click="BtnFiltrar_Click"/>

							<Button x:Name="BtnLimpiar"
                                    Content="Limpiar"
                                    Width="190"
                                    Height="44"
                                    Margin="24,0,0,0"
                                    Background="White"
                                    Foreground="#006AA6"
                                    BorderBrush="#006AA6"
                                    BorderThickness="1"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Click="BtnLimpiar_Click"/>
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- ACTIVIDAD RECIENTE -->
				<Border Background="White"
                        CornerRadius="14"
                        Padding="24">

					<StackPanel>

						<TextBlock Text="Actividad reciente"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,12"/>

						<ItemsControl x:Name="LstActividades">

							<ItemsControl.ItemTemplate>
								<DataTemplate>

									<Border BorderBrush="#D1D5DB"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12"
                                            Margin="0,0,0,8"
                                            Background="White">

										<TextBlock Text="{Binding TextoActividad}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827"
                                                   TextWrapping="Wrap"/>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<TextBlock x:Name="TxtSinResultados"
                                   Text="No hay actividades para los filtros seleccionados."
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"
                                   Visibility="Collapsed"/>
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>